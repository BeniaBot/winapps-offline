@echo off
title WinApps Offline - disc check
rem %~dp0 is this file's own folder, whatever drive letter the disc got today
set "WINAPPS_TOOLDIR=%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
set RC=%errorlevel%
if "%RC%"=="0" goto done
if "%RC%"=="3" goto done
if "%RC%"=="4" goto done
echo.
echo   The disc check could not start on this computer (code %RC%).
echo   Windows PowerShell is blocked or restricted here.
echo   This is a setting on the computer - the disc itself is fine.
echo   See the file KRA-OTI / 'kra-oti.txt (Hebrew name) in the disc root' in the root of the disc.
echo.
pause
:done
